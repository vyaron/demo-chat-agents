# Dependencies
node_modules/

# Build outputs
dist/
build/
coverage/
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Dev-loop generated output — plans mirror, tickets, agent reports, traces.
# Regenerated every run, so a demo leaves no diff to review. The README is the
# one hand-written file in there and stays tracked.
.orchestrate/*
!.orchestrate/README.md

# Test artifacts
playwright-report/
test-results/

# TypeScript
*.tsbuildinfo

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Misc
*.tmp
*.temp
