# Dependencies
node_modules/

# Build outputs
dist/
build/
coverage/
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Dev-loop generated output — plans mirror, tickets, agent reports, traces.
# Regenerated every run, so a demo leaves no diff to review. The README is the
# one hand-written file in there and stays tracked.
.orchestrate/*
!.orchestrate/README.md

# Concurrency-demo scratch — the live console log plus one report per reviewer
# lens. Ignored as a whole directory, not just *.log, so the .md reports the
# agents write don't show up as untracked files after a demo run.
.lab/

# Test artifacts
playwright-report/
test-results/

# TypeScript
*.tsbuildinfo

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Misc
*.tmp
*.temp
