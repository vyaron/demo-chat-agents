# --- MCP server credentials (consumed by .mcp.json via ${VAR} expansion) ---
# These must be present in the SHELL ENVIRONMENT when you launch `claude`.
# Claude Code does not read this file automatically.

# Figma personal access token (Settings -> Security -> Personal access tokens)
# Needs "File content: Read" scope. Starts with figd_
FIGMA_API_KEY=

# GitHub personal access token. Starts with ghp_
GITHUB_TOKEN=

# Linear API key (Settings -> API -> Personal API keys). Starts with lin_api_
LINEAR_API_KEY=
# Linear team UUID. NOTE: the MCP server expects LINEAR_TEAM, not LINEAR_TEAM_ID
LINEAR_TEAM=

# --- Application vars ---
FIGMA_URL=
